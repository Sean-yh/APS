# -----------------------------------------------------------------------------
# Backend (FastAPI) env
# -----------------------------------------------------------------------------
#
# Notes
# - This repo uses an "OpenAI-compatible" /v1/chat/completions API for the LLM.
# - Prefer LLM_* vars. Avoid mixing with OPENAI_*/GOOGLE_* to prevent accidental
#   fallback to the wrong provider.

# LLM API (OpenAI-compatible)
LLM_API_BASE=https://www.packyapi.com
LLM_API_KEY=your-api-key

# 模型配置
LLM_MODEL=gemini-3-flash-preview
# Gemini 3 官方文档建议保持默认 temperature=1.0；低于 1.0 可能出现循环/性能下降等“意外行为”
LLM_TEMPERATURE=1.0
AGENT_MAX_TOOL_ITERATIONS=30

# GX ERP（拉取实时订单/库存）
GX_ERP_API_URL=
GX_ERP_TOKEN=
GX_ERP_IS_TEST=true
GX_ERP_TIMEOUT_S=60

# 是否在每次 reschedule 工具调用时自动同步 ERP（默认 false；ERP 拉取可能较慢）
APS_AUTO_SYNC_ERP=false

# Postgres（Railway 推荐使用 DATABASE_URL）
# 例: postgresql://user:pass@host:port/dbname
DATABASE_URL=

# Optional DB startup tuning (avoid hanging forever if DB is temporarily down)
DB_CONNECT_TIMEOUT_S=5

# -----------------------------------------------------------------------------
# Frontend (Next.js) env
# -----------------------------------------------------------------------------
#
# Railway: set this in the FRONTEND service env to point to the backend service URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
